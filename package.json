{
  "name": "sparcoon",
  "version": "0.9.2",
  "description": "Three.js runtime for visual effects authored in the Sparcoon Editor - precompiled artifacts, one draw call per emitter, no eval.",
  "keywords": [
    "three",
    "threejs",
    "three.js",
    "particles",
    "particle-system",
    "vfx",
    "visual-effects",
    "fx",
    "instanced",
    "instancing",
    "billboard",
    "transform-feedback",
    "webgl",
    "webgl2",
    "glsl",
    "3d",
    "animation",
    "playable-ads",
    "esm",
    "typescript",
    "sparcoon"
  ],
  "homepage": "https://jango-git.github.io/sparcoon-editor/",
  "bugs": {
    "url": "https://github.com/jango-git/sparcoon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jango-git/sparcoon.git"
  },
  "license": "MIT",
  "author": "jango",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "tag": "experimental"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write . && eslint src --fix",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.157.0 <0.180.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.157.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.26.0",
    "prettier": "^3.9.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
